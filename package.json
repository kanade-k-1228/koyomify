{
  "name": "datex",
  "version": "0.1.0",
  "description": "A small, pipeline-style calendar library built around an immutable Day class.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./locale/jp": {
      "types": "./dist/locale/jp.d.ts",
      "import": "./dist/locale/jp.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "author": "Ryosuke Ohta <ryosuke.ohta@turing-motors.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanade-k-1228/datex.git"
  },
  "bugs": {
    "url": "https://github.com/kanade-k-1228/datex/issues"
  },
  "homepage": "https://github.com/kanade-k-1228/datex#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "date",
    "calendar",
    "day",
    "holiday",
    "business-calendar",
    "dsl",
    "rules"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@holiday-jp/holiday_jp": "^2.4.0"
  },
  "peerDependenciesMeta": {
    "@holiday-jp/holiday_jp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@holiday-jp/holiday_jp": "^2.4.0",
    "typescript": "^5.6.0"
  }
}
